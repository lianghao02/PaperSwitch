<Window x:Class="PaperSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:PaperSwitch.Models"
        xmlns:viewModels="clr-namespace:PaperSwitch.ViewModels"
        mc:Ignorable="d"
        Title="PaperSwitch 紙張排版工坊 — 文件轉 PDF 與視覺化裝訂"
        Height="820" Width="1240"
        MinHeight="650" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushPaperBg}"
        Icon="{StaticResource PaperSwitchFileIcon}"
        FontFamily="{StaticResource AppFontFamily}"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.DataContext>
        <viewModels:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 頂部手帳導覽列 -->
            <RowDefinition Height="*" />    <!-- 中央紙張排版畫布 -->
            <RowDefinition Height="Auto" /> <!-- 底部操作與導出列 -->
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- 頂部導覽列 (Top Header) -->
        <!-- ============================================================ -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushCardBg}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="1" Opacity="0.05" Color="#2D2825" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左側：標題與手帳徽章 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource BrushTerracottaLight}" Margin="0,0,14,0">
                        <Image Source="{StaticResource PaperSwitchFileIcon}" Width="24" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PaperSwitch" Style="{StaticResource TextH1}" Foreground="{StaticResource BrushTerracotta}" Margin="0,0,8,0" />
                            <Border Background="{StaticResource BrushForestMossLight}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding AppVersionBadge, FallbackValue='v4.0.0'}" Style="{StaticResource TextMeta}" Foreground="{StaticResource BrushForestMoss}" />
                            </Border>
                            <Button Content="{Binding CheckUpdateButtonText, FallbackValue='🔄 檢查更新'}" 
                                    Style="{StaticResource BtnOutlineCraft}" 
                                    Command="{Binding CheckUpdateCommand}" 
                                    Padding="8,2" FontSize="11" VerticalAlignment="Center" 
                                    ToolTip="透過 GitHub Release 檢查是否有新版本" />
                        </StackPanel>
                        <TextBlock Text="Windows 原生 .NET 8 · 100% 向量無損 PDF 裝訂與 Office 轉換" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 右側：縮放滑桿與檔案匯入 -->
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 縮放控制器 -->
                    <Border Background="{StaticResource BrushPaperBg}" CornerRadius="8" Padding="12,6" Margin="0,0,16,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="12" Foreground="{StaticResource BrushPencilGray}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Slider Width="110" Minimum="90" Maximum="480" Value="{Binding ZoomLevel, Mode=TwoWay}"
                                    Style="{StaticResource CozySlider}" VerticalAlignment="Center" ToolTip="縮放卡片大小 (支援 Ctrl+滾輪)" />
                            <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:F0}px'}" Style="{StaticResource TextMeta}" Width="42" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
                        </StackPanel>
                    </Border>

                    <!-- 選擇檔案按鈕 -->
                    <Button Content="＋ 選擇檔案" Style="{StaticResource BtnOutlineCraft}" Click="SelectFiles_Click" ToolTip="支援 PDF、Word、Excel、PPT 與圖片" />
                </StackPanel>

                <!-- 批次編輯工具移至頂部，和排版操作保持相近。 -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="↶ 復原" Style="{StaticResource BtnOutlineCraft}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Margin="4,0" ToolTip="快捷鍵: Ctrl+Z" />
                    <Button Content="↷ 重做" Style="{StaticResource BtnOutlineCraft}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Margin="4,0" ToolTip="快捷鍵: Ctrl+Y" />
                    <Button Content="全選" Style="{StaticResource BtnOutlineCraft}" Command="{Binding SelectAllCommand}" Margin="4,0" ToolTip="快捷鍵: Ctrl+A" />
                    <Button Content="反選" Style="{StaticResource BtnOutlineCraft}" Command="{Binding InvertSelectionCommand}" Margin="4,0" />
                    <Button Content="↶ 逆轉 90°" Style="{StaticResource BtnOutlineCraft}" Click="BatchRotateCCW_Click" Margin="4,0" ToolTip="快捷鍵: Shift+R" />
                    <Button Content="↷ 順轉 90°" Style="{StaticResource BtnOutlineCraft}" Click="BatchRotateCW_Click" Margin="4,0" ToolTip="快捷鍵: R" />
                    <Button Content="← 前移" Style="{StaticResource BtnOutlineCraft}" Command="{Binding MoveSelectedLeftCommand}" Margin="4,0" ToolTip="快捷鍵: Ctrl+←" />
                    <Button Content="後移 →" Style="{StaticResource BtnOutlineCraft}" Command="{Binding MoveSelectedRightCommand}" Margin="4,0" ToolTip="快捷鍵: Ctrl+→" />
                    <Button Content="🗑 移除選取" Style="{StaticResource BtnOutlineCraft}" Command="{Binding DeleteSelectedCommand}" Margin="4,0" ToolTip="快捷鍵: Delete" />
                    <Button Content="清空" Style="{StaticResource BtnOutlineCraft}" Command="{Binding ClearAllCommand}" Margin="4,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 中央主畫布 (Center Arranger Canvas) -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" Background="{StaticResource BrushPaperBg}" x:Name="ArrangerCanvas">
            <!-- 空白狀態提示 (Empty State Dropzone) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="40" Padding="48,36"
                    Background="{StaticResource BrushCardBg}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="2"
                    CornerRadius="16"
                    Effect="{StaticResource CardShadow}"
                    x:Name="EmptyStateBorder"
                    Panel.ZIndex="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPages}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                    <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource BrushTerracottaLight}" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="📂" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="將文件或圖片拖曳至此開始排版" Style="{StaticResource TextH2}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="支援 PDF、Word (.docx/.doc)、Excel (.xlsx/.xls)、PPT (.pptx/.ppt) 與圖片 (.png/.jpg/.webp) 自動轉檔與極速縮圖預覽。"
                               Style="{StaticResource TextCaption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" />
                    <Button Content="從電腦選取檔案" Style="{StaticResource BtnPrimaryCraft}" HorizontalAlignment="Center" Click="SelectFiles_Click" />
                </StackPanel>
            </Border>

            <!-- 卡片列表捲軸區 -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          Padding="24"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="MainScrollViewer_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="MainScrollViewer_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="MainScrollViewer_PreviewMouseLeftButtonUp"
                          x:Name="MainScrollViewer">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <!-- 空白畫布時不覆蓋投遞卡，確保中央選檔按鈕可直接點擊。 -->
                            <DataTrigger Binding="{Binding HasPages}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding Pages}" x:Name="CardsItemsControl" HorizontalContentAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:PaperItem}">
                            <Border Width="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Background="{StaticResource BrushCardBg}"
                                    CornerRadius="10"
                                    Cursor="Hand"
                                    AllowDrop="True"
                                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                                    MouseMove="Card_MouseMove"
                                    DragOver="Card_DragOver"
                                    DragLeave="Card_DragLeave"
                                    Drop="Card_Drop">
                                
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Margin" Value="10" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushTerracotta}" />
                                                <Setter Property="Effect" Value="{StaticResource SelectedCardShadow}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                                                <Setter Property="Opacity" Value="0.58" />
                                                <Setter Property="Effect" Value="{StaticResource CardHoverShadow}" />
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <TranslateTransform Y="-10" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDropTarget}" Value="True" />
                                                    <Condition Binding="{Binding IsDropAfter}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushTerracotta}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="Effect" Value="{StaticResource SelectedCardShadow}" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDropTarget}" Value="True" />
                                                    <Condition Binding="{Binding IsDropAfter}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushTerracotta}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="Effect" Value="{StaticResource SelectedCardShadow}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /> <!-- 卡片頂部標籤 -->
                                        <RowDefinition Height="*" />    <!-- 縮圖主體 -->
                                    </Grid.RowDefinitions>

                                    <!-- 頂部頁碼與旋轉角度標籤 -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 頁碼標籤 -->
                                        <Border Grid.Column="0" HorizontalAlignment="Left" Background="{StaticResource BrushTagBg}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding PageDisplayInfo}" Style="{StaticResource TextMeta}" Foreground="{StaticResource BrushCharcoal}" />
                                        </Border>

                                        <!-- 旋轉標記 -->
                                        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{StaticResource BrushTerracottaLight}" CornerRadius="4" Padding="5,2"
                                                Visibility="Visible">
                                            <TextBlock Text="{Binding RotationDisplay}" Style="{StaticResource TextMeta}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTerracotta}" />
                                        </Border>
                                    </Grid>

                                    <!-- 縮圖呈現與旋轉矩陣 -->
                                    <Border Grid.Row="1" Background="{StaticResource BrushPaperBg}" CornerRadius="6" MinHeight="140" MaxHeight="480" ClipToBounds="True" Margin="0,2,0,6">
                                        <Grid>
                                            <!-- 載入中動畫 -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Visibility="{Binding IsLoadingThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Text="載入中..." Style="{StaticResource TextMeta}" Foreground="{StaticResource BrushPencilLight}" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- 實際縮圖影像 (支援旋轉) -->
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.LayoutTransform>
                                                    <RotateTransform Angle="{Binding Rotation}" />
                                                </Image.LayoutTransform>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <!-- 拖曳插入槽：隨目標左右半邊顯示於兩張紙中間。 -->
                                    <Border x:Name="DropBeforeSlot" Grid.RowSpan="2" Width="30" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                            Margin="-40,0,0,0" Background="#FFFDF9" BorderBrush="{StaticResource BrushTerracotta}"
                                            BorderThickness="1.5" CornerRadius="7" Panel.ZIndex="10">
                                        <TextBlock Text="＋" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTerracotta}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDropTarget}" Value="True" />
                                                            <Condition Binding="{Binding IsDropAfter}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Border x:Name="DropAfterSlot" Grid.RowSpan="2" Width="30" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                            Margin="0,0,-40,0" Background="#FFFDF9" BorderBrush="{StaticResource BrushTerracotta}"
                                            BorderThickness="1.5" CornerRadius="7" Panel.ZIndex="10">
                                        <TextBlock Text="＋" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTerracotta}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDropTarget}" Value="True" />
                                                            <Condition Binding="{Binding IsDropAfter}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空白畫布框選視覺，不攔截卡片互動。 -->
            <Canvas IsHitTestVisible="False" x:Name="SelectionCanvas">
                <Rectangle x:Name="SelectionRectangle" Visibility="Collapsed"
                           Stroke="{StaticResource BrushTerracotta}" StrokeThickness="1.5"
                           StrokeDashArray="3,2" Fill="#22D97736" />
                <!-- 不參與版面配置的拖曳插入標記，避免 Margin 造成卡片重排抖動。 -->
                <Border x:Name="DropInsertionSlot" Width="36" Visibility="Collapsed"
                        Background="#FFFDF9" BorderBrush="{StaticResource BrushTerracotta}" BorderThickness="1.5"
                        CornerRadius="7" Panel.ZIndex="20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="＋" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTerracotta}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="插入" Style="{StaticResource TextMeta}" FontSize="10" Foreground="{StaticResource BrushTerracotta}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Canvas>

            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0"
                    Background="#FDF8F2" BorderBrush="{StaticResource BrushTerracotta}" BorderThickness="1.5"
                    CornerRadius="10" Padding="14,9" Effect="{StaticResource SelectedCardShadow}"
                    Visibility="{Binding IsDraggingPages, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding DraggedPageCount, StringFormat=📄 正在打包移動 {0} 張}" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushCharcoal}" />
            </Border>

            <!-- 忙碌指示遮罩 (Busy Overlay) -->
            <Border Background="#BFEFE9DF" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" IsHitTestVisible="True" x:Name="BusyOverlay" Panel.ZIndex="20">
                <Border Background="{StaticResource BrushCardBg}" CornerRadius="12" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Effect="{StaticResource CardHoverShadow}">
                    <StackPanel HorizontalAlignment="Center" Width="360">
                        <TextBlock Text="⚙️" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextBody}" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14" />
                        <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressValue}" Maximum="100"
                                     Height="8" Background="{StaticResource BrushPaperBg}" Foreground="{StaticResource BrushTerracotta}" />
                        <TextBlock Text="請勿關閉工坊；完成後會自動將紙張加入畫布。" Style="{StaticResource TextMeta}"
                                   Foreground="{StaticResource BrushPencilGray}" TextAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- 底部操作與導出列 (Bottom Operation Bar) -->
        <!-- ============================================================ -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushCardBg}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左側：紙張張數統計與選取摘要 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushTagBg}" CornerRadius="6" Padding="10,5" Margin="0,0,12,0">
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushCharcoal}" />
                    </Border>
                </StackPanel>

                <!-- 右側：所有輸出設定與導出動作改為橫向排列。 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="輸出方式" Style="{StaticResource TextMeta}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <RadioButton Content="合併單檔" IsChecked="{Binding Options.MergeIntoSinglePdf, Mode=TwoWay}"
                                 GroupName="ExportMode" Margin="0,0,10,0" Cursor="Hand" Foreground="{StaticResource BrushCharcoal}" VerticalAlignment="Center" />
                    <RadioButton Content="拆分獨立存檔" GroupName="ExportMode" Cursor="Hand" Foreground="{StaticResource BrushCharcoal}" VerticalAlignment="Center"
                                 Click="SplitMode_Click" />
                    <TextBlock Text="檔名／前綴" Style="{StaticResource TextMeta}" Margin="14,0,6,0" VerticalAlignment="Center" />
                    <TextBox Width="190" Height="34" Padding="10,4" VerticalContentAlignment="Center"
                             Text="{Binding Options.CustomFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="合併：輸入完整檔名；拆分：輸入共同前綴（例如：報告_001.pdf）" />
                    <Button Content="🧹 清理成品與暫存" Style="{StaticResource BtnOutlineCraft}" Click="ClearProcessingFolders_Click" Margin="0,0,8,0" ToolTip="清空 PaperSwitch 的成品與轉檔暫存資料夾" />
                    <Button Content="📁 輸出資料夾" Style="{StaticResource BtnOutlineCraft}" Command="{Binding OpenConvertedFolderCommand}" Margin="0,0,8,0" ToolTip="開啟 converted/ 目錄" />
                    <Button Content="✨ 開始裝訂導出" Style="{StaticResource BtnPrimaryCraft}" Command="{Binding ExportPdfCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
