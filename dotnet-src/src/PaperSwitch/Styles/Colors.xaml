<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 2D Q 版工坊高對比手作色盤 (Bright 2D Chibi Workshop Palette) -->
    <Color x:Key="ColorPaperBg">#FAF7F0</Color>
    <Color x:Key="ColorCardBg">#FFFFFF</Color>
    <Color x:Key="ColorBorder">#94765D</Color>
    <Color x:Key="ColorBorderDark">#5E3A20</Color>
    
    <!-- 楓糖金橘主要操作 (烤吐司金黃，醒目暖心) -->
    <Color x:Key="ColorTerracotta">#E68E28</Color>
    <Color x:Key="ColorTerracottaHover">#F09E38</Color>
    <Color x:Key="ColorTerracottaLight">#FCECD9</Color>
    
    <!-- 活潑薄荷苔綠 (選取與第二操作，清新森林) -->
    <Color x:Key="ColorForestMoss">#247253</Color>
    <Color x:Key="ColorForestMossHover">#1C5E44</Color>
    <Color x:Key="ColorForestMossLight">#E2F5EC</Color>
    
    <!-- 高對比手繪黑墨水 (深焙可可黑，抗疲勞超清晰) -->
    <Color x:Key="ColorCharcoal">#26170E</Color>
    <Color x:Key="ColorPencilGray">#483526</Color>
    <Color x:Key="ColorPencilLight">#5A4333</Color>
    <Color x:Key="ColorTagBg">#F0E8D9</Color>

    <!-- 工作桌標題帶溫潤鼠尾草森林綠 (擺脫死黑，清新高雅) -->
    <Color x:Key="ColorBannerBg">#386B52</Color>
    <Color x:Key="ColorBannerText">#FFFFFF</Color>
    <Color x:Key="ColorBannerSubText">#E1F3EA</Color>

    <!-- 實體筆刷 (SolidColorBrush) -->
    <SolidColorBrush x:Key="BrushPaperBg" Color="{StaticResource ColorPaperBg}" />
    <SolidColorBrush x:Key="BrushCardBg" Color="{StaticResource ColorCardBg}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderDark" Color="{StaticResource ColorBorderDark}" />
    
    <SolidColorBrush x:Key="BrushTerracotta" Color="{StaticResource ColorTerracotta}" />
    <SolidColorBrush x:Key="BrushTerracottaHover" Color="{StaticResource ColorTerracottaHover}" />
    <SolidColorBrush x:Key="BrushTerracottaLight" Color="{StaticResource ColorTerracottaLight}" />
    
    <SolidColorBrush x:Key="BrushForestMoss" Color="{StaticResource ColorForestMoss}" />
    <SolidColorBrush x:Key="BrushForestMossHover" Color="{StaticResource ColorForestMossHover}" />
    <SolidColorBrush x:Key="BrushForestMossLight" Color="{StaticResource ColorForestMossLight}" />
    
    <SolidColorBrush x:Key="BrushCharcoal" Color="{StaticResource ColorCharcoal}" />
    <SolidColorBrush x:Key="BrushPencilGray" Color="{StaticResource ColorPencilGray}" />
    <SolidColorBrush x:Key="BrushPencilLight" Color="{StaticResource ColorPencilLight}" />
    <SolidColorBrush x:Key="BrushTagBg" Color="{StaticResource ColorTagBg}" />

    <SolidColorBrush x:Key="BrushBannerBg" Color="{StaticResource ColorBannerBg}" />
    <SolidColorBrush x:Key="BrushBannerText" Color="{StaticResource ColorBannerText}" />
    <SolidColorBrush x:Key="BrushBannerSubText" Color="{StaticResource ColorBannerSubText}" />

    <!-- 2D 手作微立體陰影 (Chunky 2.5D Dropshadows) -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="6" Direction="270" ShadowDepth="2" Opacity="0.12" Color="#543825" />
    <DropShadowEffect x:Key="CardHoverShadow" BlurRadius="10" Direction="270" ShadowDepth="3" Opacity="0.22" Color="#543825" />
    <DropShadowEffect x:Key="SelectedCardShadow" BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.45" Color="#2E8B65" />

</ResourceDictionary>
