<Window x:Class="PaperSwitch.GameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PaperSwitch" Width="460" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BrushPaperBg}" FontFamily="{StaticResource AppFontFamily}"
        Foreground="{StaticResource BrushCharcoal}">
    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="IconBadge" Width="46" Height="46" CornerRadius="12" BorderThickness="2"
                    BorderBrush="{StaticResource BrushBorderDark}" Background="{StaticResource BrushCardBg}" VerticalAlignment="Top">
                <TextBlock x:Name="IconText" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TitleText" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource GameHeading}" FontSize="19" TextWrapping="Wrap" />
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <TextBox x:Name="MessageText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource BrushCharcoal}" />
        </ScrollViewer>
        <StackPanel x:Name="ButtonPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" />
    </Grid>
</Window>
