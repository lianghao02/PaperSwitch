<Window x:Class="PaperSwitch.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重新命名輸出檔案" Height="210" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F7F4ED" FontFamily="{StaticResource AppFontFamily}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="✏️ 重新命名選取紙張" Style="{StaticResource TextH2}" />
        <TextBlock Grid.Row="1" Margin="0,10,0,12" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                   Text="此名稱會用於「拆分獨立存檔」的輸出檔名；多張紙會自動加上連號。" />
        <TextBox x:Name="NameTextBox" Grid.Row="2" Height="34" Padding="10,5" VerticalContentAlignment="Center"
                 BorderBrush="#D8CFC2" BorderThickness="1" Background="White" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="78" Height="32" Margin="0,0,8,0" />
            <Button Content="套用名稱" IsDefault="True" MinWidth="92" Height="32" Click="Confirm_Click"
                    Background="#D97736" Foreground="White" BorderBrush="#D97736" />
        </StackPanel>
    </Grid>
</Window>
