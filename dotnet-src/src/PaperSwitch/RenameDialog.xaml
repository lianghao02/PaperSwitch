<Window x:Class="PaperSwitch.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="輸入設定" Width="440" SizeToContent="Height" MaxHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BrushPaperBg}" FontFamily="{StaticResource AppFontFamily}"
        Foreground="{StaticResource BrushCharcoal}">
    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Text="✏️ 重新命名選取紙張" Style="{StaticResource GameHeading}" FontSize="19" TextWrapping="Wrap" />
        <TextBlock x:Name="Explanation" Grid.Row="1" Margin="0,8,0,14" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                   Text="此名稱會用於「拆分獨立存檔」的輸出檔名；多張紙會自動加上連號。" />
        <TextBox x:Name="NameTextBox" Grid.Row="2" Style="{StaticResource WorkshopTextBox}" MinHeight="38" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="88" Margin="0,0,10,0" Style="{StaticResource BtnOutlineCraft}" />
            <Button x:Name="ApplyButton" Content="套用名稱" IsDefault="True" MinWidth="104" Click="Confirm_Click" Style="{StaticResource BtnPrimaryCraft}" />
        </StackPanel>
    </Grid>
</Window>
