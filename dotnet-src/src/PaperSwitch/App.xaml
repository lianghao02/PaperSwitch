<Application x:Class="PaperSwitch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <!-- 原生向量檔案圖示：紙張、折角與暖橘裝訂線。 -->
            <DrawingImage x:Key="PaperSwitchFileIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#FAECE1" Geometry="M4,2 L19,2 L26,9 L26,30 L4,30 Z" />
                        <GeometryDrawing Brush="#FFFFFF">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#2D2825" Thickness="1.5" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M4,2 L19,2 L26,9 L26,30 L4,30 Z M19,2 L19,9 L26,9" FillRule="EvenOdd" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#D97736" Geometry="M8,14 L22,14 L22,17 L8,17 Z" />
                        <GeometryDrawing Brush="#D97736" Geometry="M8,20 L19,20 L19,23 L8,23 Z" />
                        <GeometryDrawing Brush="#5B8266" Geometry="M8,26 L16,26 L16,28 L8,28 Z" />
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/WarmCozyTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
